{
  "name": "nextjs-store",
  "version": "0.1.0",
  "packageManager": "npm@11.6.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "jest",
